<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="440"
        x:Class="Viola.Avalonia.Forms.Settings.SettingsWindow"
        Title="Settings"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#333333">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>
    </Window.Styles>
    <StackPanel Margin="12" Spacing="8">
        <Border Background="#3A3A3A" CornerRadius="4" Padding="12">
            <StackPanel Spacing="8">
                    <TextBlock Text="Default Platform:" Width="130" VerticalAlignment="Center" Foreground="White"/>
                    <ComboBox x:Name="cmbPlatform" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Dump Input:" Width="130" VerticalAlignment="Center" Foreground="White"/>
                    <TextBox x:Name="txtDumpInput" Width="240"/>
                    <Button x:Name="btnBrowseDumpInput" Content="Browse" Width="70" Click="btnBrowseDumpInput_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Dump Output:" Width="130" VerticalAlignment="Center" Foreground="White"/>
                    <TextBox x:Name="txtDumpOutput" Width="240"/>
                    <Button x:Name="btnBrowseDumpOutput" Content="Browse" Width="70" Click="btnBrowseDumpOutput_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Pack Input:" Width="130" VerticalAlignment="Center" Foreground="White"/>
                    <TextBox x:Name="txtPackInput" Width="240"/>
                    <Button x:Name="btnBrowsePackInput" Content="Browse" Width="70" Click="btnBrowsePackInput_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Pack Output:" Width="130" VerticalAlignment="Center" Foreground="White"/>
                    <TextBox x:Name="txtPackOutput" Width="240"/>
                    <Button x:Name="btnBrowsePackOutput" Content="Browse" Width="70" Click="btnBrowsePackOutput_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Vanilla CPK List:" Width="130" VerticalAlignment="Center" Foreground="White"/>
                    <TextBox x:Name="txtVanillaCpk" Width="240"/>
                    <Button x:Name="btnBrowseVanillaCpk" Content="Browse" Width="70" Click="btnBrowseVanillaCpk_Click"/>
                </StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<TextBlock Text="Lua function map:" Width="130" VerticalAlignment="Center" Foreground="White"/>
					<TextBox x:Name="luaFuncMap" Width="240"/>
					<Button x:Name="btnBrowseLuaFuncMap" Content="Browse" Width="70"/>
				</StackPanel>
				<CheckBox x:Name="isDecompileLuaDump" Content="Decompile and deobfuscate Lua scripts on dump" Foreground="White" IsEnabled="False"/>
				<CheckBox x:Name="isResolveLuaDump" Content="Resolve Lua hashes on dump" Foreground="White" IsChecked="True" IsEnabled="False"/>
                <CheckBox x:Name="chkClearOutput" Content="Clear Output Folder Before Packing" Foreground="White" />
                <CheckBox x:Name="chkSmartDump" Content="Smart Dump (Skip existing files)" Foreground="White"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="btnSave" Content="Save" Width="90" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="90" Click="btnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>